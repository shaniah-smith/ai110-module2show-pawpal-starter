%% PawPal+: Phase 6 final UML, updated to match pawpal_system.py exactly.
%% Compare with diagrams/uml_draft.mmd (Phase 1) to see what changed during
%% implementation: Priority/Frequency became explicit enums, Task gained a
%% scheduled_date + next_occurrence()/to_dict()/from_dict(), Owner gained
%% find_pet_for_task(), and Scheduler grew from 2 methods to a full
%% algorithmic layer (sorting, filtering, conflicts, recurrence, and the
%% Challenge 1 next-available-slot finder).
%% (This file is identical to diagrams/uml.mmd, which the starter repo's
%% grading scaffold expects at that path.)

classDiagram
    class Owner {
        +String name
        +List~Pet~ pets
        +add_pet(pet)
        +all_tasks() List~Task~
        +find_pet(name) Pet
        +find_pet_for_task(task) Pet
        +to_dict() dict
        +from_dict(data) Owner
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task)
        +task_count() int
        +incomplete_tasks() List~Task~
        +to_dict() dict
        +from_dict(data) Pet
    }

    class Task {
        +String description
        +Time scheduled_time
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +Date scheduled_date
        +bool completed
        +int task_id
        +mark_complete()
        +mark_incomplete()
        +next_occurrence() Task
        +overlaps_with(other) bool
        +to_dict() dict
        +from_dict(data) Task
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +sort_by_priority_then_time() List~Task~
        +sort_by_time() List~Task~
        +filter_within_time_budget(tasks, minutes) tuple
        +filter_incomplete() List~Task~
        +filter_by_pet(name) List~Task~
        +filter_by_date(date) List~Task~
        +find_conflicts() List~tuple~
        +complete_task(task) Task
        +recurring_tasks() List~Task~
        +find_next_available_slot(duration) Time
        +build_daily_plan(minutes, date) dict
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Task --> Priority : uses
    Task --> Frequency : uses
    Scheduler --> "1" Owner : reads from
